{
  "name": "@se-oss/sha256",
  "version": "1.2.0",
  "description": "Lightweight JavaScript utilities for SHA-256 and HMAC-SHA-256 hashing, compatible with any JS runtime.",
  "keywords": [
    "hashing",
    "SHA-256",
    "HMAC-SHA-256",
    "JavaScript",
    "crypto",
    "edge-runtime",
    "browser",
    "Node.js"
  ],
  "homepage": "https://github.com/shahradelahi/sha256#readme",
  "repository": "github:shahradelahi/sha256",
  "license": "MIT",
  "author": "Shahrad Elahi <shahrad@litehex.com> (https://github.com/shahradelahi)",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": "./dist/node.js",
        "default": "./dist/node.cjs"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!**/*.d.cts"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup && tsup --dts-only --format esm src/index.ts",
    "clean": "git clean -dfx node_modules dist .tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm typecheck && eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "pnpm build && pnpm lint && pnpm test && pnpm format:check",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@shahrad/prettier-config",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@shahrad/eslint-config": "^1.0.1",
    "@shahrad/prettier-config": "^1.2.2",
    "@shahrad/tsconfig": "^1.2.0",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
