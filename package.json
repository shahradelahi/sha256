{
  "name": "@se-oss/sha256",
  "version": "1.0.1",
  "description": "Lightweight JavaScript utilities for SHA-256 and HMAC-SHA-256 hashing, compatible with any JS runtime.",
  "keywords": [
    "hashing",
    "SHA-256",
    "HMAC-SHA-256",
    "JavaScript",
    "crypto",
    "edge-runtime",
    "browser",
    "Node.js"
  ],
  "homepage": "https://github.com/shahradelahi/sha256#readme",
  "repository": "github:shahradelahi/sha256",
  "license": "MIT",
  "author": "Shahrad Elahi <shahrad@litehex.com> (https://github.com/shahradelahi)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**",
    "!**/*.d.cts"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup && tsup --dts-only --format esm",
    "clean": "git clean -dfx node_modules dist .tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm typecheck && eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "pnpm build && pnpm lint && pnpm test && pnpm format:check",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@shahrad/prettier-config",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@shahrad/eslint-config": "^1.0.0",
    "@shahrad/prettier-config": "^1.2.2",
    "@shahrad/tsconfig": "^1.2.0",
    "@types/node": "^22.13.13",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
